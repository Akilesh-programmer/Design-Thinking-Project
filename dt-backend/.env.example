# Application
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Database
MONGO_URI=mongodb://localhost:27017/scaap
DB_NAME=scaap

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRE=7d
REFRESH_TOKEN_EXPIRE=30d

# Verification
VERIFICATION_SECRET=your-verification-secret-key-change-in-production

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
S3_REGION=us-east-1
S3_BUCKET=scaap-bucket

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Service
AI_API_BASE_URL=http://localhost:5000
AI_API_KEY=your-ai-api-key
AI_IMAGE_CALLBACK_URL=https://your-backend/api/ai/callback
