{
  "name": "scaap-backend",
  "version": "1.0.0",
  "description": "SCAAP - Secure Campus Attendance Verification Platform Backend",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "NODE_ENV=development nodemon server.js",
    "test": "NODE_ENV=test jest --coverage",
    "test:watch": "NODE_ENV=test jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "worker": "node workers/verificationWorker.js",
    "migrate": "node scripts/migrate.js"
  },
  "keywords": [
    "attendance",
    "verification",
    "image-analysis",
    "geolocation"
  ],
  "author": "SCAAP Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-validator": "^7.0.0",
    "mongoose": "^7.5.0",
    "redis": "^4.6.10",
    "bull": "^4.11.4",
    "socket.io": "^4.7.2",
    "http": "^0.0.1-security",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "dotenv": "^16.3.1",
    "jsonwebtoken": "^9.1.0",
    "bcryptjs": "^2.4.3",
    "aws-sdk": "^2.1495.0",
    "axios": "^1.5.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "express-rate-limit": "^7.0.0",
    "hpp": "^0.2.3",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@babel/preset-env": "^7.23.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
